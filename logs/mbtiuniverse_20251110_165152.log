  <div class="tgme_widget_message_text js-message_text" dir="auto">
   ៕
   <a href="?q=%23Fact">
    #Fact
   </a>
   <br/>
   ―――——
   <br/>
   .
   <b>
    چیزهایی که تایپ‌ها نمیگن:
    <br/>
   </b>
   <br/>
   <br/>
   ـ INTP : "دوست دارم روز به روز کارای تکراری انجام بدم"
   <br/>
   <br/>
   ـ ISTP : "اجازه میدم اینو خودت بفهمی"
   <br/>
   <br/>
   ـ INTJ : "من الان واقعا بهت نیاز دارم"
   <br/>
   <br/>
   ـ INFJ : "همینه که هست، به همین راحتی"
   <br/>
   <br/>
   ـ INFP : "من با این راحت‌ نیستم. ختم کلام"
   <br/>
   <br/>
   ـ ISFP : "درباره این شایعه‌ای که پیچیده چیزی شنیدی؟"
   <br/>
   <br/>
   ـ ISFJ : "من بیخیالش شدم. بیا فراموش کنیم اصلا اتفاق افتاده"
   <br/>
   <br/>
   ـ ISTJ : "اشکالی نداره بزاریم همینطوری که هست باشه، نیازی نیست پرفکت باشه"
   <br/>
   <br/>
   ـ ENTP : "من قراره فقط یک کارو یک چیز رو انجام بدم"
   <br/>
   <br/>
   ـ ENFP : "این خسته کننده بنظر میاد، ترجیح میدم داخل بمونم"
   <br/>
   <br/>
   ـ ESTJ : "این خوبه که اجازه بدی یبار ینفر دیگه رهبری رو به عهده بگیره"
   <br/>
   <br/>
   ـ ENTJ : "من دارم بیخیال این پروژه میشم"
   <br/>
   <br/>
   ـ ENFJ : "احساس تو درباره این اهمیتی نداره"
   <br/>
   <br/>
   ـ ESFJ : "میدونی چیه، من فقط میخوام خارج از این موضوع بمونم"
   <br/>
   <br/>
   ـ ESTP : "نیازی نیست همیشه برنده شم"
   <br/>
   <br/>
   ـ ESFP : "مشکلی نیست، من اینو بد برداشت نمیکنم"
   <br/>
   <br/>
   <br/>
